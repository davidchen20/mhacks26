# Copy this file to .env.demo beside package.json; Python reads it automatically.
SPACETIMEDB_HOST=https://YOUR_SPACETIMEDB_HOST
SPACETIMEDB_DATABASE=YOUR_DATABASE_NAME_OR_IDENTITY
# Leave empty for public reads. Supply an authorized token if your instance requires it.
SPACETIMEDB_TOKEN=
DEMO_MEAL=dinner
SPACETIMEDB_MENU_REDUCER=record_menu_waste
# Next.js: copy this line into .env.local (use your reachable server URL when hosted).
DEMO_FASTAPI_URL=http://127.0.0.1:8000
